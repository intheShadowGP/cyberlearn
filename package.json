{
  "name": "cyberacademie",
  "private": true,
  "version": "1.4.3",
  "type": "module",
  "description": "Plateforme d'apprentissage de la cybersécurité — statique, hors ligne, sans compte.",
  "scripts": {
    "dev": "vite",
    "validate:content": "vitest run src/content/validate.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run validate:content && npm run typecheck && npm run lint && vite build",
    "build:subpath": "npm run validate:content && vite build --base=/cyberacademie/",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "inventory": "node scripts/inventory.mjs",
    "banks": "node scripts/gen-banks.mjs",
    "metrics": "node scripts/metrics.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "^17.14.0",
    "jsdom": "31.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
